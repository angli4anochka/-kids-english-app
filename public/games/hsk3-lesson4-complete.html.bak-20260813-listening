const stageParams=new URLSearchParams(location.hash.slice(1)||location.search);
const stageFrom=Math.max(1,Number(stageParams.get("from")||1));
const stageTo=Math.min(62,Number(stageParams.get("to")||62));
if(stageFrom===stageTo)document.documentElement.classList.add("single-stage");
document.querySelectorAll(".screen").forEach((screen,index)=>{const number=index+1;if(number<stageFrom||number>stageTo)screen.remove()});
const stageStorageKey=name=>"hsk3_l4_"+stageFrom+"_"+stageTo+"_"+name;
const screens=[...document.querySelectorAll(".screen")];
let current=Number(localStorage.getItem(stageStorageKey("screen"))||0);
let scores=JSON.parse(localStorage.getItem(stageStorageKey("scores"))||"{}");
const reviewUser=(()=>{try{return JSON.parse(localStorage.getItem("authUser")||"null")}catch{return null}})();
const reviewUserId=reviewUser?.id||reviewUser?.email||"teacher";
const reviewProgressKey=`hsk-dictionary:${reviewUserId}`;
const reviewSeenKey=`hsk-review-known:${reviewUserId}:4`;
let reviewProgress=(()=>{try{return JSON.parse(localStorage.getItem(reviewProgressKey)||"{}")}catch{return {}}})();
let reviewSeen=new Set((()=>{try{return JSON.parse(localStorage.getItem(reviewSeenKey)||"[]")}catch{return []}})());
let reviewQueue=REVIEW_WORDS.filter(([word])=>(reviewProgress[word]||0)<3&&!reviewSeen.has(word));
let reviewWordIndex=Number(localStorage.getItem(stageStorageKey("review_word"))||0);
let reviewWordRevealed=false;

function normalize(v){return (v||"").toString().trim().toLowerCase().replace(/[，,。.!！?？、；;：“”"'\s]/g,"")}
function correct(el){
  const mode=el.dataset.mode||"oneof",v=normalize(el.value),raw=el.dataset.answer||"";
  if(mode==="all") return raw.split("&&").every(x=>v.includes(normalize(x)));
  if(mode==="includes") return v.includes(normalize(raw));
  return raw.split("|").map(normalize).includes(v);
}
function saveAll(){
  const d={};document.querySelectorAll(".answer,input[data-save]").forEach((el,i)=>d[i]=el.value);
  localStorage.setItem(stageStorageKey("answers"),JSON.stringify(d));
}
function restoreAll(){
  const d=JSON.parse(localStorage.getItem(stageStorageKey("answers"))||"{}");
  document.querySelectorAll(".answer,input[data-save]").forEach((el,i)=>{if(d[i]!==undefined)el.value=d[i]});
}
function checkBlock(id,fid,key){
  const els=[...document.getElementById(id).querySelectorAll(".answer")];let c=0;
  els.forEach(el=>{el.classList.remove("ok","bad");if(correct(el)){el.classList.add("ok");c++}else el.classList.add("bad")});
  scores[key]={correct:c,total:els.length};localStorage.setItem(stageStorageKey("scores"),JSON.stringify(scores));saveAll();
  const f=document.getElementById(fid);f.className="feedback "+(c===els.length?"ok":"bad");f.textContent=c===els.length?`Отлично: ${c} из ${els.length}.`:`Правильно: ${c} из ${els.length}. Исправь отмеченные ответы.`;
  updateResults();
}
function updateScreen(){
  current=Math.max(0,Math.min(current,screens.length-1));screens.forEach((s,i)=>s.classList.toggle("active",i===current));
  counter.textContent=`${current+1} / ${screens.length}`;progressBar.style.width=((current+1)/screens.length*100)+"%";
  prev.disabled=current===0;next.textContent=current===screens.length-1?"К началу":"Дальше";
  localStorage.setItem(stageStorageKey("screen"),current);
  document.querySelectorAll("audio").forEach(a=>{if(!a.closest(".screen")?.classList.contains("active"))a.pause()});
  if(current===screens.length-1)updateResults();
}
function go(n){if(current===screens.length-1&&n===1)current=0;else current+=n;updateScreen()}
function speakChinese(text){if(!("speechSynthesis" in window))return;speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(text);u.lang="zh-CN";u.rate=.75;speechSynthesis.speak(u)}

function renderReviewWord(){
  if(!document.getElementById("reviewHanzi"))return;
  if(!reviewQueue.length){reviewHanzi.textContent="✓";reviewPinyin.textContent="";reviewMeaning.textContent="Все слова этого урока просмотрены";reviewLessonTag.textContent="Готово";reviewWordCounter.textContent="0 слов";reviewReveal.classList.remove("hidden");return}
  reviewWordIndex=(reviewWordIndex+reviewQueue.length)%reviewQueue.length;
  const [h,p,r,l]=reviewQueue[reviewWordIndex];
  reviewHanzi.textContent=h;reviewPinyin.textContent=p;reviewMeaning.textContent=r;reviewLessonTag.textContent="Урок "+l;reviewWordCounter.textContent=`${reviewWordIndex+1} / ${reviewQueue.length}`;reviewReveal.classList.add("hidden");
  reviewWordRevealed=false;
  localStorage.setItem(stageStorageKey("review_word"),reviewWordIndex);
}
function reviewWordMove(n){
  if(!reviewQueue.length)return;
  if(n<0){reviewWordIndex+=n;renderReviewWord();return}
  const word=reviewQueue[reviewWordIndex][0];
  if(!reviewWordRevealed)reviewProgress[word]=Math.min(3,(reviewProgress[word]||0)+1);
  reviewSeen.add(word);
  localStorage.setItem(reviewProgressKey,JSON.stringify(reviewProgress));
  localStorage.setItem(reviewSeenKey,JSON.stringify([...reviewSeen]));
  reviewQueue.splice(reviewWordIndex,1);
  if(reviewWordIndex>=reviewQueue.length)reviewWordIndex=0;
  renderReviewWord();
}
function revealReviewWord(){reviewWordRevealed=true;reviewReveal?.classList.remove("hidden")}
function speakReviewWord(){if(reviewQueue.length)speakChinese(reviewQueue[reviewWordIndex][0])}
