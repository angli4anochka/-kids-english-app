let mediaRecorder=null,chunks=[],activeRecAudio=null,activeStart=null,activeStop=null;
async function startRecording(btn){
 try{const stream=await navigator.mediaDevices.getUserMedia({audio:true});chunks=[];mediaRecorder=new MediaRecorder(stream);activeStart=btn;activeStop=btn.parentElement.querySelector(".secondary");activeRecAudio=btn.parentElement.querySelector("audio");btn.disabled=true;activeStop.disabled=false;
 mediaRecorder.ondataavailable=e=>chunks.push(e.data);mediaRecorder.onstop=()=>{activeRecAudio.src=URL.createObjectURL(new Blob(chunks,{type:"audio/webm"}));stream.getTracks().forEach(t=>t.stop());activeStart.disabled=false;activeStop.disabled=true};mediaRecorder.start()}catch(e){alert("Браузер не дал доступ к микрофону.")}
}
function stopRecording(){if(mediaRecorder&&mediaRecorder.state!=="inactive")mediaRecorder.stop()}

let drawing=false,activeCanvas=null;
function drawGrid(c){
 const ctx=c.getContext("2d"),s=c.width;ctx.clearRect(0,0,s,s);ctx.fillStyle="#fff";ctx.fillRect(0,0,s,s);ctx.strokeStyle="#bbb";ctx.lineWidth=2;ctx.strokeRect(1,1,s-2,s-2);ctx.save();ctx.setLineDash([6,5]);ctx.strokeStyle="#ddd";ctx.lineWidth=1.3;ctx.beginPath();ctx.moveTo(s/2,2);ctx.lineTo(s/2,s-2);ctx.moveTo(2,s/2);ctx.lineTo(s-2,s/2);ctx.moveTo(3,3);ctx.lineTo(s-3,s-3);ctx.moveTo(s-3,3);ctx.lineTo(3,s-3);ctx.stroke();ctx.restore();
 const mode=c.dataset.mode;if(mode==="model"||mode==="trace"){ctx.textAlign="center";ctx.textBaseline="middle";ctx.font="82px KaiTi,STKaiti,SimSun,serif";ctx.fillStyle=mode==="model"?"#222":"#c6c6c6";ctx.fillText(c.dataset.char,s/2,s/2+3)}
}
function initCanvases(){
 document.querySelectorAll(".hanziCanvas").forEach(c=>{drawGrid(c);if(c.dataset.mode==="model")return;
 c.addEventListener("pointerdown",e=>{drawing=true;activeCanvas=c;c.setPointerCapture?.(e.pointerId);const r=c.getBoundingClientRect(),ctx=c.getContext("2d");ctx.beginPath();ctx.moveTo((e.clientX-r.left)*c.width/r.width,(e.clientY-r.top)*c.height/r.height);e.preventDefault()});
 c.addEventListener("pointermove",e=>{if(!drawing||activeCanvas!==c)return;const r=c.getBoundingClientRect(),ctx=c.getContext("2d");ctx.strokeStyle="#222";ctx.lineWidth=7;ctx.lineCap="round";ctx.lineJoin="round";ctx.lineTo((e.clientX-r.left)*c.width/r.width,(e.clientY-r.top)*c.height/r.height);ctx.stroke();e.preventDefault()});
 ["pointerup","pointerleave","pointercancel"].forEach(ev=>c.addEventListener(ev,()=>{drawing=false;activeCanvas=null}));
 });
}
function clearCopyWord(i){document.querySelectorAll(`.hanziCanvas[data-word="${i}"]`).forEach(drawGrid)}
function clearCopyPage(btn){btn.closest(".screen").querySelectorAll(".hanziCanvas").forEach(drawGrid)}

function stagePrompt4(el,index,title){const holder=el.closest(".task,.wb4Choice,.sceneCard,.pictureCard,.copyRow,.panel")||el.parentElement;return (holder?.querySelector("p,.questionText,.prompt,.cn")?.textContent||holder?.textContent||el.placeholder||`${title} · ${index+1}`).replace(/\s+/g," ").trim().slice(0,500)}
function collectStageAnswers4(screen){if(!screen)return[];const title=(screen.querySelector("h1,h2")?.textContent||`HSK 3 · этап ${stageFrom}`).trim();return[...screen.querySelectorAll("input,select,textarea")].filter(el=>{if((el.type==="radio"||el.type==="checkbox")&&!el.checked)return false;return String(el.value||"").trim()!==""}).map((el,index)=>{const studentAnswer=String(el.value||"").trim(),expected=el.dataset.answer||"";return{prompt:stagePrompt4(el,index,title),studentAnswer,correctAnswer:expected||undefined,isCorrect:expected?correct(el):null,answerType:el.type||el.tagName.toLowerCase()}})}
function reportHskStageResult4(action="change"){const screen=screens[0],title=(screen?.querySelector("h1,h2")?.textContent||`HSK 3 · этап ${stageFrom}`).replace(/\s+/g," ").trim(),answers=collectStageAnswers4(screen),graded=answers.filter(a=>a.isCorrect!==null);const result={version:3,type:"hsk-stage-result",source:"hsk3-lesson4",stage:stageFrom,title,action,answers,score:graded.filter(a=>a.isCorrect).length,total:graded.length,writtenCount:answers.filter(a=>a.isCorrect===null).length};try{const saved=JSON.parse(localStorage.getItem("hsk3-l4-stage-results")||"{}");saved[stageFrom]=result;localStorage.setItem("hsk3-l4-stage-results",JSON.stringify(saved))}catch(e){}window.parent.postMessage(result,location.origin)}
let stageReportTimer4=null;document.addEventListener("click",e=>{const action=e.target.closest("button")?.getAttribute("onclick")||"";if(/check|save/i.test(action))setTimeout(()=>reportHskStageResult4(action),150)});document.addEventListener("change",()=>setTimeout(()=>reportHskStageResult4("change"),80));document.addEventListener("input",()=>{clearTimeout(stageReportTimer4);stageReportTimer4=setTimeout(()=>reportHskStageResult4("input"),350)});
function updateResults(){
 let got=0,total=0,rows=[];Object.entries(scores).forEach(([k,v])=>{got+=v.correct;total+=v.total;rows.push([k,v.correct,v.total])});
 const pct=total?Math.round(got/total*100):0;if(resultPercent)resultPercent.textContent=pct+"%";if(resultText)resultText.textContent=pct>=90?"Материал усвоен уверенно.":pct>=70?"Хорошо. Повтори ошибки.":pct>0?"Есть слабые места, пройди их ещё раз.":"Выполни упражнения и проверяй блоки.";
 if(resultGrid)resultGrid.innerHTML=rows.slice(-12).map(r=>`<div class="resultItem"><b>${r[1]}/${r[2]}</b><span>${r[0]}</span></div>`).join("");
}
function resetCourse(){if(!confirm("Сбросить ответы и прогресс?"))return;["screen","scores","answers","review_word"].map(stageStorageKey).forEach(k=>localStorage.removeItem(k));scores={};current=0;document.querySelectorAll(".answer,input[data-save]").forEach(el=>{el.value="";el.classList.remove("ok","bad")});updateScreen();updateResults();renderReviewWord()}

function toggleChat(){chatPanel.classList.toggle("open")}
async function sendChat(){
 const t=chatInput.value.trim();if(!t)return;chatLog.innerHTML+=`<div class="chatMsg me">${escapeHtml(t)}</div>`;chatInput.value="";const w=document.createElement("div");w.className="chatMsg";w.textContent="DeepSeek анализирует…";chatLog.appendChild(w);
 try{const r=await fetch("/kids-api/hsk/chat",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({message:t,history:[],context:JSON.stringify({course:"HSK 3",lesson:"Урок 4 · 她总是笑着跟客人说话",stage:stageFrom,title:screens[0]?.querySelector("h2")?.textContent||"",screenText:(screens[0]?.innerText||"").replace(/\s+/g," ").trim().slice(0,6000),savedAnswers:collectStageAnswers4(screens[0])}),instructions:["Отвечай по-русски.","Анализируй содержимое текущего экрана и сохранённые ответы ученика.","Китайские примеры давай с пиньинем и переводом.","Исправляй ошибки и кратко объясняй правило."]})});if(!r.ok)throw new Error(`HTTP ${r.status}`);const d=await r.json();w.textContent=d.reply||d.answer||"Нет ответа."}catch(e){w.textContent="Не удалось получить ответ DeepSeek. Попробуй ещё раз."}
}function escapeHtml(s){return s.replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}

document.querySelectorAll(".answer,input[data-save]").forEach(el=>el.addEventListener("input",saveAll));
restoreAll();restoreWb4Radios();initCanvases();renderReviewWord();updateScreen();updateResults();
</script></body></html>