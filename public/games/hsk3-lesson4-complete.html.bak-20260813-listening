const WB4_AUDIO = "data:audio/mpeg;base64,";
document.querySelectorAll(".wb4AudioPlayer").forEach(a => {
  a.src = WB4_AUDIO;
  const saved = Number(localStorage.getItem("hsk3_l4_wb_audio_time") || 0);
