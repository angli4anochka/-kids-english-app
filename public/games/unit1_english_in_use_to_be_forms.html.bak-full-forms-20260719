<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Grammar — Verb to be</title>
  <style>
    :root{--navy:#102a56;--blue:#3976e8;--purple:#7658df;--green:#14845e;--red:#d74655;--muted:#667d9f}*{box-sizing:border-box}
    html,body{margin:0;width:100%;height:100%;overflow:hidden;font-family:Inter,ui-rounded,"Nunito Sans",system-ui,sans-serif;color:var(--navy);background:radial-gradient(circle at 8% 0,#dceaff 0,transparent 34%),linear-gradient(145deg,#fbfdff,#edf3ff)}
    body{height:100dvh}.app{width:min(1260px,100%);height:100dvh;margin:auto;padding:8px 14px;display:grid;grid-template-rows:auto minmax(0,1fr);gap:8px;overflow:hidden}
    header{display:flex;align-items:center;justify-content:space-between;gap:12px}.title{display:flex;align-items:center;gap:10px;min-width:0}.badge{width:40px;aspect-ratio:1;display:grid;place-items:center;border:2px solid #fff;border-radius:12px;color:#fff;background:linear-gradient(145deg,#6096f3,#355fc5);box-shadow:0 7px 18px #315fc733;font-size:1.2rem;font-weight:900;flex:0 0 auto}h1,h2,h3,p{margin:0}h1{font-size:1.55rem;line-height:1.05;letter-spacing:0}.eyebrow{color:#6d83a5;font-size:.66rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.counter{padding:7px 12px;border:1px solid #5175af26;border-radius:999px;background:#ffffffdc;box-shadow:0 6px 18px #30518614;font-weight:950}
    .panel{min-height:0;display:none;border:3px solid #fff;border-radius:18px;background:#ffffffdf;box-shadow:0 16px 40px #284e8b1f;overflow:hidden}.panel.active{display:flex}.button{min-height:38px;border:0;border-radius:11px;padding:0 16px;color:#fff;background:linear-gradient(135deg,var(--blue),var(--purple));box-shadow:0 7px 18px #526cd633;font:inherit;font-weight:900;cursor:pointer}.button.secondary{color:var(--navy);background:#e8f0fc;box-shadow:none}.button.send{display:none;background:linear-gradient(135deg,#13805c,#24a878)}.button:disabled{opacity:.55;cursor:not-allowed}
    .rule-screen{padding:14px;align-items:center;gap:16px}.rule-main{flex:1;display:flex;flex-direction:column;gap:10px;min-width:0}.rule-main h2{font-size:1.55rem;line-height:1.08}table{width:100%;border-collapse:separate;border-spacing:0;overflow:hidden;border:2px solid #d3e0f2;border-radius:14px;background:#fff}th,td{padding:8px 12px;border-bottom:1px solid #dbe6f4;text-align:left;line-height:1.2}tr:last-child td{border-bottom:0}th{color:#fff;background:#173d7b;font-size:.72rem;letter-spacing:.06em;text-transform:uppercase}td{font-weight:800}.form{display:inline-block;padding:4px 8px;border-radius:8px;color:#fff;background:var(--blue);font-weight:950}.short{background:var(--purple)}.negative{width:min(310px,100%);padding:14px;border:2px solid #d8e3f3;border-radius:16px;background:#f5f8ff}.negative h3{margin-bottom:9px}.negative-row{display:grid;grid-template-columns:1fr auto 1fr;gap:8px;padding:8px 10px;margin-top:7px;border-radius:11px;background:#fff;font-weight:900}.negative-row span:nth-child(2){color:var(--blue)}.negative-row span:last-child{color:var(--purple)}.negative .button{width:100%;margin-top:12px}
    .exercise{padding:10px;flex-direction:column;gap:8px;overflow:hidden}.screen-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.screen-head h2{font-size:1.42rem;line-height:1.08}.screen-head p{margin-top:2px;color:var(--muted);font-size:.9rem;font-weight:750}.nav{display:flex;align-items:center;gap:8px;margin-top:auto;min-height:38px}.nav .next,.nav .finish{margin-left:auto}.feedback{min-height:20px;font-size:.94rem;font-weight:900}.feedback.good{color:var(--green)}.feedback.bad{color:var(--red)}
    .short-grid{min-height:0;display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.short-row{display:grid;grid-template-columns:1fr 135px;align-items:center;gap:10px;padding:9px 12px;border:2px solid #d8e3f3;border-radius:13px;background:#fafdff;font-size:.98rem;font-weight:850}.short-row input{width:100%;height:36px;border:2px solid #c7d7ec;border-radius:10px;padding:0 10px;color:var(--navy);background:#fff;font:inherit;font-weight:900;outline:none}.short-row input:focus{border-color:var(--blue)}.correct{border-color:#55b996!important;background:#eefaf6!important}.wrong{border-color:#e37682!important;background:#fff2f3!important}
    .letter-layout{min-height:0;display:grid;grid-template-columns:minmax(0,1fr) 230px;gap:10px;overflow:hidden}.letter{min-height:0;padding:12px 14px;border:2px solid #d6e2f2;border-radius:15px;background:#fff;line-height:1.72;font-size:.9rem;overflow:hidden}.gap{width:66px;height:30px;margin:0 2px;border:2px solid #c7d7ec;border-radius:9px;color:var(--navy);background:#fafdff;font:inherit;font-weight:900;text-align:center;outline:none}.gap:focus{border-color:var(--blue)}.word-bank{padding:12px;border:2px solid #d8e3f3;border-radius:15px;background:#f6f9ff}.word-bank h3{margin-bottom:9px}.chips{display:flex;flex-wrap:wrap;gap:7px}.chip{padding:7px 9px;border-radius:10px;color:#fff;background:linear-gradient(135deg,var(--blue),var(--purple));font-weight:900}.hint{margin-top:10px;color:var(--muted);font-size:.82rem;line-height:1.35}
    .question-rule{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.transform{padding:10px;border:2px solid #d7e3f3;border-radius:14px;background:#f8fbff}.statement{color:var(--muted);font-weight:800}.question{margin-top:5px;color:var(--purple);font-size:1.02rem;font-weight:950}.answer-chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:7px}.answer-chips span{padding:5px 8px;border-radius:8px;background:#e8f0fc;font-size:.78rem;font-weight:850}.question-tasks{min-height:0;display:grid;grid-template-columns:repeat(2,1fr);gap:7px}.q-row{display:grid;grid-template-columns:1fr 122px 154px;align-items:center;gap:7px;padding:8px 9px;border:2px solid #d8e3f3;border-radius:12px;background:#fafdff;font-size:.9rem;font-weight:850}.q-row select{height:34px;border:2px solid #c7d7ec;border-radius:9px;color:var(--navy);background:#fff;font:inherit;font-size:.8rem;font-weight:850;outline:none}.q-row.correct select{border-color:var(--green)}.q-row.wrong select{border-color:var(--red)}
    @media(max-width:900px){html,body{overflow:auto}.app{height:auto;min-height:100dvh;overflow:visible}.panel{overflow:visible}.rule-screen{flex-direction:column}.negative{width:100%}.short-grid,.question-tasks{grid-template-columns:1fr}.letter-layout{grid-template-columns:1fr}.word-bank{order:-1}.exercise{min-height:0;overflow:visible}}@media(max-width:600px){.app{padding:9px}.panel{border-width:3px;border-radius:18px}.short-row{grid-template-columns:1fr 112px}.question-rule{grid-template-columns:1fr}.q-row{grid-template-columns:1fr 105px}.q-row select:last-child{grid-column:1/-1}.screen-head{display:block}.screen-head .button{margin-top:9px}.nav{flex-wrap:wrap}.nav .next,.nav .finish{margin-left:0}.feedback{width:100%}.letter{padding:12px;line-height:1.7}.gap{width:62px}h1{font-size:1.35rem}}

  </style>
</head>
<body>
  <main class="app">
    <header><div class="title"><span class="badge">8</span><div><p class="eyebrow">Grammar</p><h1>Verb to be</h1></div></div><span class="counter">Rule</span></header>

    <section class="panel rule-screen active" data-screen="rule"><div class="rule-main"><h2>Forms of to be</h2><table><thead><tr><th>Pronoun</th><th>Full form</th><th>Short form</th></tr></thead><tbody><tr><td>I</td><td><span class="form">I am</span></td><td><span class="form short">I’m</span></td></tr><tr><td>he / she / it</td><td><span class="form">is</span></td><td><span class="form short">he’s / she’s / it’s</span></td></tr><tr><td>you / we / they</td><td><span class="form">are</span></td><td><span class="form short">you’re / we’re / they’re</span></td></tr></tbody></table></div><aside class="negative"><h3>Negative forms</h3><div class="negative-row"><span>is not</span><span>→</span><span>isn’t</span></div><div class="negative-row"><span>are not</span><span>→</span><span>aren’t</span></div><div class="negative-row"><span>I am not</span><span>→</span><span>I’m not</span></div><button class="button begin" type="button">Start practice</button></aside></section>

    <section class="panel exercise" data-screen="short"><div class="screen-head"><div><p class="eyebrow">Screen 1</p><h2>Write the short forms</h2></div><button class="button secondary show-rule" type="button">Rule</button></div><div class="short-grid">
      <label class="short-row" data-answer="He’s"><span>He is →</span><input autocomplete="off" aria-label="Short form of He is"></label><label class="short-row" data-answer="She isn’t"><span>She is not →</span><input autocomplete="off" aria-label="Short form of She is not"></label><label class="short-row" data-answer="We’re"><span>We are →</span><input autocomplete="off" aria-label="Short form of We are"></label><label class="short-row" data-answer="I’m"><span>I am →</span><input autocomplete="off" aria-label="Short form of I am"></label><label class="short-row" data-answer="They aren’t"><span>They are not →</span><input autocomplete="off" aria-label="Short form of They are not"></label><label class="short-row" data-answer="You’re"><span>You are →</span><input autocomplete="off" aria-label="Short form of You are"></label>
    </div><div class="nav"><button class="button check-short" type="button">Check</button><p class="feedback short-feedback" aria-live="polite"></p><button class="button next next-letter" type="button">Next</button></div></section>

    <section class="panel exercise" data-screen="letter"><div class="screen-head"><div><p class="eyebrow">Screen 2</p><h2>Complete Wendy’s letter</h2><p>Use the words from the word bank. You can use a word more than once.</p></div></div><div class="letter-layout"><div class="letter"><b>Dear Anna,</b><br>Hi! How are you? I <input class="gap" data-answer="’m" aria-label="Gap 1"> fine. I <input class="gap" data-answer="’m" aria-label="Gap 2"> at my new school. It <input class="gap" data-answer="’s" aria-label="Gap 3"> great, but it <input class="gap" data-answer="isn’t" aria-label="Gap 4"> very big. I like my classmates. They <input class="gap" data-answer="’re" aria-label="Gap 5"> very friendly.<br>I <input class="gap" data-answer="’m" aria-label="Gap 6"> in Class 3B. The lessons <input class="gap" data-answer="aren’t" aria-label="Gap 7"> very difficult. My favourite subject <input class="gap" data-answer="’s" aria-label="Gap 8"> Maths. My Maths teacher <input class="gap" data-answer="’s" aria-label="Gap 9"> very nice!<br>Love, Wendy</div><aside class="word-bank"><h3>Word bank</h3><div class="chips"><span class="chip">’m</span><span class="chip">’s</span><span class="chip">’re</span><span class="chip">isn’t</span><span class="chip">aren’t</span></div><p class="hint">Remember: the apostrophe replaces missing letters.</p></aside></div><div class="nav"><button class="button secondary back-short" type="button">Back</button><button class="button check-letter" type="button">Check</button><p class="feedback letter-feedback" aria-live="polite"></p><button class="button next next-questions" type="button">Next</button></div></section>

    <section class="panel exercise" data-screen="questions"><div class="screen-head"><div><p class="eyebrow">Screen 3</p><h2>Questions with to be</h2><p>Move am, is or are before the subject.</p></div></div><div class="question-rule"><div class="transform"><p class="statement">It is a classroom.</p><p class="question">Is it a classroom?</p><div class="answer-chips"><span>Yes, it is.</span><span>No, it isn’t.</span></div></div><div class="transform"><p class="statement">They are pens.</p><p class="question">Are they pens?</p><div class="answer-chips"><span>Yes, they are.</span><span>No, they aren’t.</span></div></div></div><div class="question-tasks">
      <div class="q-row" data-q="Is it" data-a="Yes, it is."><span>a classroom ✓</span><select aria-label="Question for a classroom"><option value="">Question</option><option>Is it</option><option>Are they</option></select><select aria-label="Answer for a classroom"><option value="">Short answer</option><option>Yes, it is.</option><option>No, it isn’t.</option><option>Yes, they are.</option><option>No, they aren’t.</option></select></div>
      <div class="q-row" data-q="Are they" data-a="Yes, they are."><span>pens ✓</span><select aria-label="Question for pens"><option value="">Question</option><option>Is it</option><option>Are they</option></select><select aria-label="Answer for pens"><option value="">Short answer</option><option>Yes, it is.</option><option>No, it isn’t.</option><option>Yes, they are.</option><option>No, they aren’t.</option></select></div>
      <div class="q-row" data-q="Is it" data-a="No, it isn’t."><span>an atlas ✗</span><select aria-label="Question for an atlas"><option value="">Question</option><option>Is it</option><option>Are they</option></select><select aria-label="Answer for an atlas"><option value="">Short answer</option><option>Yes, it is.</option><option>No, it isn’t.</option><option>Yes, they are.</option><option>No, they aren’t.</option></select></div>
      <div class="q-row" data-q="Are they" data-a="No, they aren’t."><span>notebooks ✗</span><select aria-label="Question for notebooks"><option value="">Question</option><option>Is it</option><option>Are they</option></select><select aria-label="Answer for notebooks"><option value="">Short answer</option><option>Yes, it is.</option><option>No, it isn’t.</option><option>Yes, they are.</option><option>No, they aren’t.</option></select></div>
    </div><div class="nav"><button class="button secondary back-letter" type="button">Back</button><button class="button finish" type="button">Check all</button><button class="button send" type="button">Send to teacher</button><p class="feedback final-feedback" aria-live="polite"></p></div></section>
  </main>
  <script>
    const panels=[...document.querySelectorAll('.panel')],counter=document.querySelector('.counter');let scores={short:0,letter:0,questions:0},result=null;
    const normalize=value=>value.trim().toLowerCase().replace(/[‘’`]/g,"'").replace(/\s+/g,' ');function show(name){panels.forEach(panel=>panel.classList.toggle('active',panel.dataset.screen===name));counter.textContent=name==='rule'?'Rule':`${{short:1,letter:2,questions:3}[name]} / 3`}
    document.querySelector('.begin').onclick=()=>show('short');document.querySelector('.show-rule').onclick=()=>show('rule');document.querySelector('.back-short').onclick=()=>show('short');document.querySelector('.next-letter').onclick=()=>show('letter');document.querySelector('.back-letter').onclick=()=>show('letter');document.querySelector('.next-questions').onclick=()=>show('questions');
    document.querySelector('.check-short').onclick=()=>{const rows=[...document.querySelectorAll('.short-row')];let score=0;rows.forEach(row=>{const ok=normalize(row.querySelector('input').value)===normalize(row.dataset.answer);row.classList.toggle('correct',ok);row.classList.toggle('wrong',!ok);if(ok)score++});scores.short=score;const f=document.querySelector('.short-feedback');f.textContent=score===6?'Perfect! 6/6':`${score}/6 — correct the red answers.`;f.className=`feedback short-feedback ${score===6?'good':'bad'}`};
    document.querySelector('.check-letter').onclick=()=>{const gaps=[...document.querySelectorAll('.gap')];let score=0;gaps.forEach(gap=>{const ok=normalize(gap.value)===normalize(gap.dataset.answer);gap.classList.toggle('correct',ok);gap.classList.toggle('wrong',!ok);if(ok)score++});scores.letter=score;const f=document.querySelector('.letter-feedback');f.textContent=score===9?'Excellent! 9/9':`${score}/9 — check the red gaps.`;f.className=`feedback letter-feedback ${score===9?'good':'bad'}`};
    document.querySelector('.finish').onclick=()=>{const rows=[...document.querySelectorAll('.q-row')];let score=0;rows.forEach(row=>{const selects=row.querySelectorAll('select'),ok=selects[0].value===row.dataset.q&&selects[1].value===row.dataset.a;row.classList.toggle('correct',ok);row.classList.toggle('wrong',!ok);if(ok)score+=2;else{if(selects[0].value===row.dataset.q)score++;if(selects[1].value===row.dataset.a)score++}});scores.questions=score;const total=scores.short+scores.letter+scores.questions,max=23,f=document.querySelector('.final-feedback');f.textContent=total===max?`Excellent! ${total}/${max}`:`Total: ${total}/${max}. Correct the red answers.`;f.className=`feedback final-feedback ${total===max?'good':'bad'}`;result={activityId:'verb-to-be-multiscreen',scores,total,maxScore:max,completed:total===max,timestamp:new Date().toISOString()};document.querySelector('.send').style.display='inline-block'};
    document.querySelector('.send').onclick=event=>{if(!result)return;window.parent.postMessage({type:'UNIPLAY_ACTIVITY_RESULT',payload:result},'*');window.parent.postMessage({type:'lesson-result',...result},'*');try{localStorage.setItem('verb-to-be-multiscreen-result',JSON.stringify(result))}catch{}event.currentTarget.textContent='Sent';event.currentTarget.disabled=true};
  </script>
</body>
</html>
