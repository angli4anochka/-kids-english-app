    } else if (letter === 'e') {
      strokes.push([
        ...sampleCubic({ x: 60, y: -38 }, { x: 52, y: -65 }, { x: 19, y: -66 }, { x: 12, y: -42 }, 18),
        ...sampleCubic({ x: 12, y: -42 }, { x: 3, y: -10 }, { x: 44, y: 10 }, { x: 69, y: -18 }, 24),
        ...sampleLine({ x: 14, y: -39 }, { x: 59, y: -39 }, 10),
      ]);
      width = 78;
    } else if (letter === 'x') {
      strokes.push(sampleLine({ x: 14, y: -66 }, { x: 61, y: 0 }, 20));
      strokes.push(sampleLine({ x: 60, y: -66 }, { x: 13, y: 0 }, 20));
      width = 78;
    } else if (letter === 'n') {
      strokes.push([
        ...sampleLine({ x: 15, y: 0 }, { x: 15, y: -62 }, 16),
        ...sampleCubic({ x: 15, y: -62 }, { x: 34, y: -84 }, { x: 72, y: -67 }, { x: 70, y: 0 }, 28),
      ]);
      width = 82;
    } else if (letter === 't') {
      strokes.push(sampleLine({ x: 34, y: -86 }, { x: 34, y: 0 }, 22));
      strokes.push(sampleLine({ x: 12, y: -55 }, { x: 59, y: -55 }, 12));
      strokes.push(sampleCubic({ x: 34, y: 0 }, { x: 45, y: 6 }, { x: 58, y: 1 }, { x: 64, y: -8 }, 10));
      width = 70;
    } else if (letter === ' ') {
      width = 32;
    }

    return { strokes, width };
  };

  const transformPoints = (points: Point[], scale: number, dx: number, dy: number): Point[] => {
    return points.map((p) => ({ x: p.x * scale + dx, y: p.y * scale + dy }));
  };

  const makeWord = (word: string, x: number, baseline: number, scale = 1) => {
    const strokes: Point[][] = [];
    let cursor = x;

    for (const ch of word) {
      if (ch === ' ') {
        cursor += 32 * scale;
        continue;
      }
      const g = glyph(ch);
      g.strokes.forEach((stroke) => strokes.push(transformPoints(stroke, scale, cursor, baseline)));
      cursor += g.width * scale + 5 * scale;
    }

    return { strokes, width: cursor - x };
  };

  const measureWordWidth = (text: string, scale: number) => {
    return makeWord(text, 0, 0, scale).width;
  };

  const getRepeatCount = (row: LetterRow) => {
    const available = writingArea.right - writingArea.x;
    const wordWidth = measureWordWidth(row.text, row.scale || 1);
    const desiredRepeats = row.desiredRepeats || 3;
    const minRepeats = row.minRepeats || 1;

    for (let count = desiredRepeats; count >= minRepeats; count--) {
      const total = wordWidth * count + writingArea.gap * (count - 1);
      if (total <= available) return count;
    }

    return 1;
  };

  const pathFromPoints = (points: Point[]): string => {
    if (!points.length) return '';
    return 'M ' + points.map((p) => `${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' L ');
  };

  const distance = (a: Point, b: Point): number => {
    return Math.hypot(a.x - b.x, a.y - b.y);
  };

  const nearestDistanceToSamples = (point: Point, samples: Point[]): number => {
    let min = Infinity;
    for (const sample of samples) {
      const d = distance(point, sample);
      if (d < min) min = d;
    }
    return min;
  };

  const calculateItemScore = (item: TraceItem) => {
    const points = item.userPoints;
    if (points.length < 5) return { accuracy: 0, coverage: 0, minStrokeCoverage: 0 };

    let closeCount = 0;
    let veryFarCount = 0;

    for (const p of points) {
      const d = nearestDistanceToSamples(p, item.samples);
      if (d <= tolerance) closeCount++;
      if (d > tolerance * 2.2) veryFarCount++;
    }

    let covered = 0;
    const strokeStats = new Map<number, { total: number; covered: number }>();

    for (const sample of item.samples) {
      if (!strokeStats.has(sample.strokeIndex)) {
        strokeStats.set(sample.strokeIndex, { total: 0, covered: 0 });
      }
      strokeStats.get(sample.strokeIndex)!.total++;

      let isCovered = false;
      for (const p of points) {
        if (distance(sample, p) <= tolerance * 1.05) {
          isCovered = true;
          break;
        }
      }

      if (isCovered) {
        covered++;
        strokeStats.get(sample.strokeIndex)!.covered++;
      }
    }

    const strokeCoverages = [...strokeStats.values()].map((stat) => stat.covered / stat.total);
    const minStrokeCoverage = strokeCoverages.length ? Math.min(...strokeCoverages) : 0;

    const closeness = closeCount / points.length;
    const coverage = covered / item.samples.length;
    const farPenalty = Math.min(0.25, (veryFarCount / points.length) * 0.35);
    const score = Math.round(Math.max(0, Math.min(1, closeness * 0.62 + coverage * 0.48 - farPenalty)) * 100);

    return { accuracy: score, coverage, minStrokeCoverage };
  };

  const clientToSvg = (clientX: number, clientY: number): Point => {
    if (!svgRef.current) return { x: 0, y: 0 };
    const pt = svgRef.current.createSVGPoint();
    pt.x = clientX;
    pt.y = clientY;
    return pt.matrixTransform(svgRef.current.getScreenCTM()!.inverse());
  };

  const findNearestItem = (point: Point): TraceItem | null => {
    let best: TraceItem | null = null;
    let bestDistance = Infinity;

    for (const item of items) {
      if (item.done) continue;
      const nearBox =
        point.x >= item.x - 38 &&
        point.x <= item.x + item.width + 58 &&
        point.y >= item.yTop - 34 &&
        point.y <= item.yBase + 48;
      if (!nearBox) continue;

      const d = nearestDistanceToSamples(point, item.samples);
      if (d < bestDistance) {
        bestDistance = d;
        best = item;
      }
    }

    return bestDistance <= 60 ? best : null;
  };

  const handlePointerDown = (e: React.PointerEvent) => {
    e.preventDefault();
    const p = clientToSvg(e.clientX, e.clientY);
    const item = findNearestItem(p);

    if (!item) {
      setStatusClass('bad');
      setStatusMessage('Начни ближе к пунктиру.');
      return;
    }

    setActiveItem(item);
    setActiveStrokePoints([p]);
    setIsDrawing(true);
    setStatusClass('');
    setStatusMessage(`Пишем "${item.text}". Веди по пунктиру.`);

    // Add initial point
    item.userPoints.push(p);
  };

  const handlePointerMove = (e: React.PointerEvent) => {
    if (!isDrawing || !activeItem) return;
    e.preventDefault();

    const p = clientToSvg(e.clientX, e.clientY);
    setActiveStrokePoints((prev) => [...prev, p]);
    activeItem.userPoints.push(p);

    const result = calculateItemScore(activeItem);
    setStatusMessage(
      `Точность: ${result.accuracy}% · покрытие: ${Math.round(result.coverage * 100)}%`
    );
  };

  const handlePointerUp = () => {
    if (!isDrawing || !activeItem) {
      setIsDrawing(false);
      return;
    }

    activeItem.attempts.push([...activeStrokePoints]);
    const result = calculateItemScore(activeItem);

    if (result.accuracy < 48) {
      setStatusClass('bad');
      setStatusMessage(`Слишком далеко: ${result.accuracy}%. Попробуй ближе.`);
    } else if (result.accuracy >= passAccuracy && result.coverage >= passCoverage && result.minStrokeCoverage >= 0.72) {
      // Mark as done
      activeItem.done = true;
      setStatusClass('good');
      setStatusMessage(`Зачёт: "${activeItem.text}" написано. Точность ${result.accuracy}%!`);
      setDoneCount((prev) => prev + 1);
    } else {
      setStatusClass('');
      setStatusMessage(
        `Пока не зачёт: ${result.accuracy}%, покрытие ${Math.round(result.coverage * 100)}%. Допиши до конца.`
      );
    }

    setItems([...items]); // Trigger re-render
    setActiveItem(null);
    setActiveStrokePoints([]);
    setIsDrawing(false);
  };

  // Build worksheet on mount or config change
  useEffect(() => {
    const newItems: TraceItem[] = [];
    let globalRowIndex = 0;

    config.rows.forEach((row) => {
      // Split text by "+" to create multiple lines
      const words = row.text.split('+').map(w => w.trim()).filter(w => w.length > 0);

      words.forEach((wordText, wordIdx) => {
        // Each word gets its own line, no repeats
        const scale = row.scale || 1;
        const wordWidth = measureWordWidth(wordText, scale);
        const startX = writingArea.x + Math.max(0, (writingArea.right - writingArea.x - wordWidth) / 2);

        const yTop = 225 + globalRowIndex * 125;
        const yBase = yTop + 80;
        const baseline = yBase; // baseline должна совпадать с нижней линией

        const x = startX;
        const word = makeWord(wordText, x, baseline, scale);

        const samples: (Point & { strokeIndex: number; pointIndex: number })[] = [];
        word.strokes.forEach((stroke, strokeIndex) => {
          stroke.forEach((p, pointIndex) => samples.push({ ...p, strokeIndex, pointIndex }));
        });

        newItems.push({
          id: `${globalRowIndex}-0`,
          text: wordText,
          x,
          yTop,
          yBase,
          width: word.width,
          strokes: word.strokes,
          samples,
          userPoints: [],
          attempts: [],
          done: false,
          lastAccuracy: 0,
          lastCoverage: 0,
        });

        globalRowIndex++;
      });
    });

    setItems(newItems);
    setDoneCount(0);
  }, [config]);

  return (
    <TVFrame>
      <div className="w-full h-full flex flex-col overflow-hidden" style={{
        background: 'radial-gradient(circle at top left, rgba(255, 205, 118, 0.34), transparent 30%), radial-gradient(circle at bottom right, rgba(108, 176, 255, 0.28), transparent 32%), linear-gradient(135deg, #fff8ec 0%, #eef6ff 100%)'
      }}>
        {/* Header */}
        <div className="px-3 py-2 flex justify-between items-center">
          <div>
            <h2 className="text-xl font-bold text-gray-800">{config.title}</h2>
            <p className="text-xs text-gray-600">{config.subtitle}</p>
          </div>
          <div className="px-3 py-1 bg-blue-100 rounded-full font-bold text-blue-800 text-sm">
            Готово: {doneCount} из {items.length}
          </div>
        </div>

        {/* Board */}
        <div className="flex-1 px-3 pb-3 overflow-hidden">
          <div
            ref={boardRef}
            className="relative w-full h-full bg-white rounded-3xl border-2 border-blue-100 shadow-xl overflow-hidden"
            style={{ touchAction: 'none', userSelect: 'none' }}
            onPointerDown={handlePointerDown}
            onPointerMove={handlePointerMove}
            onPointerUp={handlePointerUp}
            onPointerCancel={handlePointerUp}
          >
            <svg ref={svgRef} viewBox="0 0 1240 720" className="w-full h-full">
              <defs>
                <linearGradient id="greenHeader" x1="0" x2="1" y1="0" y2="1">
                  <stop offset="0" stopColor="#8bcf55" />
                  <stop offset="1" stopColor="#2f8e3f" />
                </linearGradient>
              </defs>

              {/* Header */}
              <rect x="26" y="20" width="1188" height="150" rx="30" fill="url(#greenHeader)" stroke="#378c32" strokeWidth="3" />
              <text x="620" y="77" fontSize="30" fontWeight="950" fill="#fff" textAnchor="middle" paintOrder="stroke" stroke="rgba(39, 99, 32, 0.55)" strokeWidth="5" strokeLinejoin="round">
                ✏️ {config.title}
              </text>
              <text x="620" y="120" fontSize="26" fontWeight="900" fill="rgba(255,255,255,0.9)" textAnchor="middle">
                {config.subtitle}
              </text>

              {/* Row lines and icons */}
              {(() => {
                const lines: React.ReactElement[] = [];
                let globalRowIdx = 0;

                config.rows.forEach((row, rowIdx) => {
                  const words = row.text.split('+').map(w => w.trim()).filter(w => w.length > 0);

                  words.forEach((wordText, wordIdx) => {
                    const yTop = 225 + globalRowIdx * 125;
                    const yMid = yTop + 40;
                    const yBase = yTop + 80;

                    lines.push(
                      <g key={`row-${rowIdx}-${wordIdx}`}>
                        <line x1="155" y1={yTop} x2="1190" y2={yTop} stroke="#b9d8ff" strokeWidth="2" />
                        <line x1="155" y1={yMid} x2="1190" y2={yMid} stroke="#b9d8ff" strokeWidth="1.5" strokeDasharray="8 9" opacity="0.9" />
                        <line x1="155" y1={yBase} x2="1190" y2={yBase} stroke="#8fc2ff" strokeWidth="2.7" />

                        <rect x="45" y={yTop - 12} width="78" height="92" rx="18" fill="#fbfff8" stroke="#b9d9aa" strokeWidth="2.5" />
                        <text x="84" y={yTop + 32} fontSize="44" textAnchor="middle" dominantBaseline="middle">{row.icon}</text>
                        <text x="84" y={yTop + 70} fontSize="16" fontWeight="900" fill="#5b734c" textAnchor="middle">{row.label}</text>
                      </g>
                    );

                    globalRowIdx++;
                  });
                });

                return lines;
              })()}

              {/* Guide paths and user paths */}
              {items.map((item) => (
                <g key={item.id}>
                  {/* Guide (dotted template) */}
                  {item.strokes.map((stroke, strokeIdx) => (
                    <path
                      key={`guide-${strokeIdx}`}
                      d={pathFromPoints(stroke)}
                      fill="none"
                      stroke="rgba(80, 95, 118, 0.58)"
                      strokeWidth="9"
                      strokeLinecap="round"
                      strokeLinejoin="round"
                      strokeDasharray="1 17"
                      opacity={item.done ? 0.14 : 0.92}
                    />
                  ))}

                  {/* Start dot */}
                  {!item.done && item.samples[0] && (
                    <>
                      <circle
                        cx={item.samples[0].x}
                        cy={item.samples[0].y}
                        r="7"
                        fill="#20bf55"
                        stroke="#fff"
                        strokeWidth="3.5"
                      />
                      <path
                        d={`M ${item.samples[0].x + 14} ${item.samples[0].y} L ${item.samples[0].x + 42} ${item.samples[0].y}`}
                        stroke="#2f80ed"
                        strokeWidth="3"
                        strokeLinecap="round"
                        fill="none"
                        opacity="0.7"
                      />
                    </>
                  )}

                  {/* User drawn paths */}
                  {item.attempts.map((attempt, attemptIdx) => (
                    <polyline
                      key={`user-${attemptIdx}`}
                      points={attempt.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ')}
                      fill="none"
                      stroke="#2f80ed"
                      strokeWidth="9"
                      strokeLinecap="round"
                      strokeLinejoin="round"
                      opacity="0.95"
                    />
                  ))}

                  {/* Current active stroke */}
                  {activeItem?.id === item.id && activeStrokePoints.length > 0 && (
                    <polyline
                      points={activeStrokePoints.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ')}
                      fill="none"
                      stroke="#2f80ed"
                      strokeWidth="9"
                      strokeLinecap="round"
                      strokeLinejoin="round"
                      opacity="0.95"
                    />
                  )}
                </g>
              ))}
            </svg>
          </div>
        </div>

        {/* Status bar */}
        <div className={`mx-6 mb-6 px-4 py-3 rounded-2xl font-bold ${
          statusClass === 'good' ? 'bg-green-100 text-green-800' :
          statusClass === 'bad' ? 'bg-red-100 text-red-800' :
          'bg-yellow-100 text-yellow-800'
        }`}>
          {statusMessage}
        </div>
      </div>
    </TVFrame>
  );
};

export default LetterTraceGame;
