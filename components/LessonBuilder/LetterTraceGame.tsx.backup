      strokes.push([...sampleCubic({ x: 28, y: -86 }, { x: 28, y: -92 }, { x: 32, y: -96 }, { x: 38, y: -92 }, 6), ...sampleCubic({ x: 38, y: -92 }, { x: 42, y: -88 }, { x: 38, y: -82 }, { x: 28, y: -86 }, 6)]);
