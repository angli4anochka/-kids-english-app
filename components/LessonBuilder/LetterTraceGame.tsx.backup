import { useEffect, useRef, useState } from 'react';
import TVFrame from '../Shared/TVFrame';

// Letter trace configuration
export interface LetterRow {
  icon: string;
  label: string;
  text: string;
  translation: string;
  desiredRepeats?: number;
  minRepeats?: number;
  scale?: number;
}

export interface LetterTraceConfig {
  title: string;
  subtitle: string;
  rows: LetterRow[];
}

interface Props {
  config: LetterTraceConfig;
}

interface Point {
  x: number;
  y: number;
}

interface TraceItem {
  id: string;
  text: string;
  x: number;
  yTop: number;
  yBase: number;
  width: number;
  strokes: Point[][];
  samples: (Point & { strokeIndex: number; pointIndex: number })[];
  userPoints: Point[];
  attempts: Point[][];
  done: boolean;
  lastAccuracy: number;
  lastCoverage: number;
}

const LetterTraceGame: React.FC<Props> = ({ config }) => {
  const svgRef = useRef<SVGSVGElement>(null);
  const boardRef = useRef<HTMLDivElement>(null);
  const [items, setItems] = useState<TraceItem[]>([]);
  const [isDrawing, setIsDrawing] = useState(false);
  const [activeItem, setActiveItem] = useState<TraceItem | null>(null);
  const [activeStrokePoints, setActiveStrokePoints] = useState<Point[]>([]);
  const [statusMessage, setStatusMessage] = useState('Пиши по пунктиру. Чем ближе линия к образцу, тем выше точность.');
  const [statusClass, setStatusClass] = useState('');
  const [doneCount, setDoneCount] = useState(0);

  const writingArea = { x: 175, right: 1185, gap: 70 };
  const tolerance = 23;
  const passAccuracy = 74;
  const passCoverage = 0.92;

  // Glyph definitions for letters
  const glyph = (letter: string): { strokes: Point[][]; width: number } => {
    const strokes: Point[][] = [];
    let width = 70;

    const sampleLine = (p0: Point, p1: Point, steps = 20): Point[] => {
      const points: Point[] = [];
      for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        points.push({ x: p0.x + (p1.x - p0.x) * t, y: p0.y + (p1.y - p0.y) * t });
      }
      return points;
    };

    const sampleCubic = (p0: Point, p1: Point, p2: Point, p3: Point, steps = 28): Point[] => {
      const points: Point[] = [];
      for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        const mt = 1 - t;
        points.push({
          x: mt ** 3 * p0.x + 3 * mt ** 2 * t * p1.x + 3 * mt * t ** 2 * p2.x + t ** 3 * p3.x,
          y: mt ** 3 * p0.y + 3 * mt ** 2 * t * p1.y + 3 * mt * t ** 2 * p2.y + t ** 3 * p3.y,
        });
      }
      return points;
    };

    // Uppercase letters
    if (letter === 'A') {
      strokes.push(sampleLine({ x: 36, y: -98 }, { x: 8, y: 0 }, 22));
      strokes.push(sampleLine({ x: 36, y: -98 }, { x: 72, y: 0 }, 22));
      strokes.push(sampleLine({ x: 22, y: -42 }, { x: 57, y: -42 }, 12));
      width = 88;
    } else if (letter === 'B') {
      strokes.push(sampleLine({ x: 15, y: -98 }, { x: 15, y: 0 }, 26));
      strokes.push([...sampleCubic({ x: 15, y: -98 }, { x: 55, y: -98 }, { x: 65, y: -75 }, { x: 50, y: -49 }, 14), ...sampleLine({ x: 50, y: -49 }, { x: 15, y: -49 }, 8)]);
      strokes.push([...sampleCubic({ x: 15, y: -49 }, { x: 60, y: -49 }, { x: 72, y: -25 }, { x: 58, y: 0 }, 14), ...sampleLine({ x: 58, y: 0 }, { x: 15, y: 0 }, 10)]);
      width = 80;
    } else if (letter === 'C') {
      strokes.push([...sampleCubic({ x: 70, y: -80 }, { x: 50, y: -100 }, { x: 20, y: -90 }, { x: 12, y: -50 }, 18), ...sampleCubic({ x: 12, y: -50 }, { x: 5, y: -10 }, { x: 25, y: 8 }, { x: 70, y: -15 }, 22)]);
      width = 78;
    } else if (letter === 'D') {
      strokes.push(sampleLine({ x: 15, y: -98 }, { x: 15, y: 0 }, 26));
      strokes.push([...sampleCubic({ x: 15, y: -98 }, { x: 60, y: -98 }, { x: 78, y: -70 }, { x: 78, y: -49 }, 16), ...sampleCubic({ x: 78, y: -49 }, { x: 78, y: -28 }, { x: 60, y: 0 }, { x: 15, y: 0 }, 16)]);
      width = 85;
    } else if (letter === 'E') {
      strokes.push(sampleLine({ x: 15, y: -98 }, { x: 15, y: 0 }, 26));
      strokes.push(sampleLine({ x: 15, y: -98 }, { x: 65, y: -98 }, 12));
      strokes.push(sampleLine({ x: 15, y: -49 }, { x: 60, y: -49 }, 10));
      strokes.push(sampleLine({ x: 15, y: 0 }, { x: 68, y: 0 }, 12));
      width = 75;
    } else if (letter === 'F') {
      strokes.push(sampleLine({ x: 15, y: -98 }, { x: 15, y: 0 }, 26));
      strokes.push(sampleLine({ x: 15, y: -98 }, { x: 65, y: -98 }, 12));
      strokes.push(sampleLine({ x: 15, y: -49 }, { x: 60, y: -49 }, 10));
      width = 70;
    } else if (letter === 'G') {
      strokes.push([...sampleCubic({ x: 70, y: -80 }, { x: 50, y: -100 }, { x: 20, y: -90 }, { x: 12, y: -50 }, 18), ...sampleCubic({ x: 12, y: -50 }, { x: 5, y: -10 }, { x: 25, y: 8 }, { x: 55, y: 0 }, 22)]);
      strokes.push(sampleLine({ x: 55, y: 0 }, { x: 72, y: 0 }, 8));
      strokes.push(sampleLine({ x: 72, y: 0 }, { x: 72, y: -40 }, 10));
      strokes.push(sampleLine({ x: 72, y: -40 }, { x: 50, y: -40 }, 6));
      width = 82;
    } else if (letter === 'H') {
      strokes.push(sampleLine({ x: 15, y: -98 }, { x: 15, y: 0 }, 26));
      strokes.push(sampleLine({ x: 70, y: -98 }, { x: 70, y: 0 }, 26));
      strokes.push(sampleLine({ x: 15, y: -49 }, { x: 70, y: -49 }, 12));
      width = 85;
    } else if (letter === 'I') {
      strokes.push(sampleLine({ x: 28, y: -98 }, { x: 28, y: 0 }, 26));
      strokes.push(sampleLine({ x: 10, y: -98 }, { x: 46, y: -98 }, 10));
      strokes.push(sampleLine({ x: 10, y: 0 }, { x: 46, y: 0 }, 10));
      width = 56;
    } else if (letter === 'J') {
      strokes.push([...sampleLine({ x: 50, y: -98 }, { x: 50, y: -15 }, 22), ...sampleCubic({ x: 50, y: -15 }, { x: 50, y: 8 }, { x: 30, y: 10 }, { x: 15, y: -5 }, 12)]);
      width = 65;
    } else if (letter === 'K') {
      strokes.push(sampleLine({ x: 15, y: -98 }, { x: 15, y: 0 }, 26));
      strokes.push(sampleLine({ x: 65, y: -98 }, { x: 15, y: -40 }, 16));
      strokes.push(sampleLine({ x: 28, y: -60 }, { x: 68, y: 0 }, 18));
      width = 75;
    } else if (letter === 'L') {
      strokes.push(sampleLine({ x: 15, y: -98 }, { x: 15, y: 0 }, 26));
      strokes.push(sampleLine({ x: 15, y: 0 }, { x: 65, y: 0 }, 12));
      width = 70;
    } else if (letter === 'M') {
      strokes.push(sampleLine({ x: 12, y: 0 }, { x: 12, y: -98 }, 26));
      strokes.push(sampleLine({ x: 12, y: -98 }, { x: 45, y: -50 }, 14));
      strokes.push(sampleLine({ x: 45, y: -50 }, { x: 78, y: -98 }, 14));
      strokes.push(sampleLine({ x: 78, y: -98 }, { x: 78, y: 0 }, 26));
      width = 90;
    } else if (letter === 'N') {
      strokes.push(sampleLine({ x: 15, y: 0 }, { x: 15, y: -98 }, 26));
      strokes.push(sampleLine({ x: 15, y: -98 }, { x: 70, y: 0 }, 28));
      strokes.push(sampleLine({ x: 70, y: 0 }, { x: 70, y: -98 }, 26));
      width = 85;
    } else if (letter === 'O') {
      strokes.push([...sampleCubic({ x: 42, y: -100 }, { x: 12, y: -95 }, { x: 5, y: -70 }, { x: 5, y: -49 }, 16), ...sampleCubic({ x: 5, y: -49 }, { x: 5, y: -28 }, { x: 12, y: 2 }, { x: 42, y: 2 }, 16), ...sampleCubic({ x: 42, y: 2 }, { x: 72, y: -3 }, { x: 79, y: -28 }, { x: 79, y: -49 }, 16), ...sampleCubic({ x: 79, y: -49 }, { x: 79, y: -70 }, { x: 72, y: -95 }, { x: 42, y: -100 }, 16)]);
      width = 84;
    } else if (letter === 'P') {
      strokes.push(sampleLine({ x: 15, y: -98 }, { x: 15, y: 0 }, 26));
      strokes.push([...sampleCubic({ x: 15, y: -98 }, { x: 58, y: -98 }, { x: 72, y: -80 }, { x: 68, y: -60 }, 14), ...sampleCubic({ x: 68, y: -60 }, { x: 64, y: -40 }, { x: 48, y: -35 }, { x: 15, y: -35 }, 14)]);
      width = 75;
    } else if (letter === 'Q') {
      strokes.push([...sampleCubic({ x: 42, y: -100 }, { x: 12, y: -95 }, { x: 5, y: -70 }, { x: 5, y: -49 }, 16), ...sampleCubic({ x: 5, y: -49 }, { x: 5, y: -28 }, { x: 12, y: 2 }, { x: 42, y: 2 }, 16), ...sampleCubic({ x: 42, y: 2 }, { x: 72, y: -3 }, { x: 79, y: -28 }, { x: 79, y: -49 }, 16), ...sampleCubic({ x: 79, y: -49 }, { x: 79, y: -70 }, { x: 72, y: -95 }, { x: 42, y: -100 }, 16)]);
      strokes.push(sampleLine({ x: 55, y: -20 }, { x: 85, y: 15 }, 10));
      width = 90;
    } else if (letter === 'R') {
      strokes.push(sampleLine({ x: 15, y: -98 }, { x: 15, y: 0 }, 26));
      strokes.push([...sampleCubic({ x: 15, y: -98 }, { x: 58, y: -98 }, { x: 72, y: -80 }, { x: 68, y: -60 }, 14), ...sampleCubic({ x: 68, y: -60 }, { x: 64, y: -40 }, { x: 48, y: -35 }, { x: 15, y: -35 }, 14)]);
      strokes.push(sampleLine({ x: 40, y: -40 }, { x: 72, y: 0 }, 12));
      width = 78;
    } else if (letter === 'S') {
      strokes.push([...sampleCubic({ x: 65, y: -75 }, { x: 50, y: -100 }, { x: 18, y: -95 }, { x: 12, y: -70 }, 16), ...sampleCubic({ x: 12, y: -70 }, { x: 8, y: -50 }, { x: 25, y: -45 }, { x: 42, y: -47 }, 14), ...sampleCubic({ x: 42, y: -47 }, { x: 60, y: -50 }, { x: 70, y: -35 }, { x: 65, y: -20 }, 14), ...sampleCubic({ x: 65, y: -20 }, { x: 58, y: 5 }, { x: 25, y: 5 }, { x: 10, y: -20 }, 16)]);
      width = 75;
    } else if (letter === 'T') {
      strokes.push(sampleLine({ x: 10, y: -98 }, { x: 70, y: -98 }, 16));
      strokes.push(sampleLine({ x: 40, y: -98 }, { x: 40, y: 0 }, 26));
      width = 80;
    } else if (letter === 'U') {
      strokes.push([...sampleLine({ x: 15, y: -98 }, { x: 15, y: -20 }, 22), ...sampleCubic({ x: 15, y: -20 }, { x: 15, y: 5 }, { x: 30, y: 8 }, { x: 42, y: 0 }, 12), ...sampleCubic({ x: 42, y: 0 }, { x: 54, y: -8 }, { x: 70, y: 5 }, { x: 70, y: -20 }, 12), ...sampleLine({ x: 70, y: -20 }, { x: 70, y: -98 }, 22)]);
      width = 85;
    } else if (letter === 'V') {
      strokes.push(sampleLine({ x: 10, y: -98 }, { x: 42, y: 0 }, 26));
      strokes.push(sampleLine({ x: 42, y: 0 }, { x: 74, y: -98 }, 26));
      width = 84;
    } else if (letter === 'W') {
      strokes.push(sampleLine({ x: 8, y: -98 }, { x: 22, y: 0 }, 26));
      strokes.push(sampleLine({ x: 22, y: 0 }, { x: 42, y: -65 }, 18));
      strokes.push(sampleLine({ x: 42, y: -65 }, { x: 62, y: 0 }, 18));
      strokes.push(sampleLine({ x: 62, y: 0 }, { x: 76, y: -98 }, 26));
      width = 84;
    } else if (letter === 'X') {
      strokes.push(sampleLine({ x: 12, y: -98 }, { x: 68, y: 0 }, 26));
      strokes.push(sampleLine({ x: 68, y: -98 }, { x: 12, y: 0 }, 26));
      width = 80;
    } else if (letter === 'Y') {
      strokes.push(sampleLine({ x: 10, y: -98 }, { x: 42, y: -45 }, 16));
      strokes.push(sampleLine({ x: 74, y: -98 }, { x: 42, y: -45 }, 16));
      strokes.push(sampleLine({ x: 42, y: -45 }, { x: 42, y: 0 }, 12));
      width = 84;
    } else if (letter === 'Z') {
      strokes.push(sampleLine({ x: 12, y: -98 }, { x: 68, y: -98 }, 16));
      strokes.push(sampleLine({ x: 68, y: -98 }, { x: 12, y: 0 }, 26));
      strokes.push(sampleLine({ x: 12, y: 0 }, { x: 68, y: 0 }, 16));
      width = 80;
    }
    // Lowercase letters
    else if (letter === 'a') {
      strokes.push([
        ...sampleCubic({ x: 58, y: -42 }, { x: 56, y: -72 }, { x: 30, y: -78 }, { x: 17, y: -58 }, 16),
        ...sampleCubic({ x: 17, y: -58 }, { x: -2, y: -28 }, { x: 13, y: 5 }, { x: 42, y: -2 }, 18),
        ...sampleCubic({ x: 42, y: -2 }, { x: 59, y: -6 }, { x: 66, y: -25 }, { x: 58, y: -42 }, 16),
      ]);
      strokes.push([...sampleCubic({ x: 63, y: -72 }, { x: 59, y: -46 }, { x: 60, y: -21 }, { x: 64, y: 0 }, 18)]);
      width = 78;
    } else if (letter === 'b') {
      strokes.push(sampleLine({ x: 15, y: -96 }, { x: 15, y: 0 }, 26));
      strokes.push([...sampleCubic({ x: 15, y: -10 }, { x: 52, y: -76 }, { x: 72, y: -42 }, { x: 58, y: -8 }, 18), ...sampleCubic({ x: 58, y: -8 }, { x: 48, y: 10 }, { x: 20, y: 8 }, { x: 15, y: -20 }, 16)]);
      width = 75;
    } else if (letter === 'c') {
      strokes.push([...sampleCubic({ x: 60, y: -52 }, { x: 48, y: -72 }, { x: 20, y: -68 }, { x: 12, y: -36 }, 16), ...sampleCubic({ x: 12, y: -36 }, { x: 5, y: -5 }, { x: 25, y: 8 }, { x: 58, y: -8 }, 20)]);
      width = 68;
    } else if (letter === 'd') {
      strokes.push(sampleLine({ x: 70, y: -96 }, { x: 70, y: 0 }, 26));
      strokes.push([...sampleCubic({ x: 70, y: -10 }, { x: 30, y: -76 }, { x: 12, y: -42 }, { x: 25, y: -8 }, 18), ...sampleCubic({ x: 25, y: -8 }, { x: 35, y: 10 }, { x: 62, y: 8 }, { x: 70, y: -20 }, 16)]);
      width = 80;
    } else if (letter === 'f') {
      strokes.push([...sampleCubic({ x: 48, y: -96 }, { x: 42, y: -102 }, { x: 28, y: -100 }, { x: 24, y: -90 }, 10), ...sampleLine({ x: 24, y: -90 }, { x: 24, y: 0 }, 24)]);
      strokes.push(sampleLine({ x: 8, y: -60 }, { x: 48, y: -60 }, 10));
      width = 56;
    } else if (letter === 'g') {
      strokes.push([...sampleCubic({ x: 58, y: -42 }, { x: 56, y: -72 }, { x: 30, y: -78 }, { x: 17, y: -58 }, 16), ...sampleCubic({ x: 17, y: -58 }, { x: -2, y: -28 }, { x: 13, y: 5 }, { x: 42, y: -2 }, 18), ...sampleCubic({ x: 42, y: -2 }, { x: 59, y: -6 }, { x: 66, y: -25 }, { x: 58, y: -42 }, 16)]);
      strokes.push([...sampleCubic({ x: 63, y: -72 }, { x: 59, y: -46 }, { x: 60, y: -10 }, { x: 60, y: 20 }, 18), ...sampleCubic({ x: 60, y: 20 }, { x: 58, y: 38 }, { x: 35, y: 42 }, { x: 18, y: 28 }, 12)]);
      width = 78;
    } else if (letter === 'h') {
      strokes.push(sampleLine({ x: 15, y: -96 }, { x: 15, y: 0 }, 26));
      strokes.push([...sampleCubic({ x: 15, y: -48 }, { x: 32, y: -76 }, { x: 62, y: -62 }, { x: 62, y: 0 }, 24)]);
      width = 75;
    } else if (letter === 'i') {
      strokes.push(sampleLine({ x: 18, y: -72 }, { x: 18, y: 0 }, 20));
      strokes.push([...sampleCubic({ x: 18, y: -86 }, { x: 18, y: -92 }, { x: 22, y: -96 }, { x: 28, y: -92 }, 6), ...sampleCubic({ x: 28, y: -92 }, { x: 32, y: -88 }, { x: 28, y: -82 }, { x: 18, y: -86 }, 6)]);
